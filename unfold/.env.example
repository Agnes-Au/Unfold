# Unfold server URL. Use / when the app is served by that server (the deployed demo).
# On a physical phone with Expo Go, use your computer's LAN address, e.g. http://192.168.1.10:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# Social-worker console URL linked from the fictional demo banner (deployed demo: /worker/).
EXPO_PUBLIC_WORKER_URL=http://localhost:5173
